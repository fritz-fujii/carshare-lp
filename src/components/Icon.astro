---
// Static MDI paths (Pictogrammers, Apache-2.0), formerly supplied by astro-icon.
import { icons } from "@iconify-json/mdi";
interface Props { name: string; class?: string }
const { name, ...attributes } = Astro.props;
const body = icons.icons[name.replace(/^mdi:/, "")]?.body;
const path = body?.match(/ d="([^"]+)"/)?.[1];
if (!path) throw new Error(`Unknown icon: ${name}`);
---
<svg {...attributes} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={path} /></svg>

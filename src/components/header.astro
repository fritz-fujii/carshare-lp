---
const isEN = Astro.url.pathname.startsWith("/en");
---

<header class="absolute top-0 z-20 flex w-full items-center justify-between px-6 py-5 text-white sm:px-8">
  <a class="text-lg font-semibold hover:underline" href={isEN ? "/en/" : "/"}>
    IS250C&nbsp;Car&nbsp;Share
  </a>
  <nav aria-label={isEN ? "Language" : "言語切替"}>
    <a class="text-sm font-semibold hover:underline" href={isEN ? "/" : "/en/"} lang={isEN ? "ja" : "en"}>
      {isEN ? "日本語" : "English"}
    </a>
  </nav>
</header>

---
// Each additional day is priced at the rate for its band. This keeps the
// total increasing with duration while rewarding longer bookings.
const rateForDay = (day: number) => {
  if (day === 1) return 14800;
  if (day <= 3) return 13000;
  if (day <= 6) return 11000;
  if (day <= 13) return 10000;
  if (day <= 29) return 8700;
  return 7500;
};
let total = 0;
const plans = Array.from({ length: 31 }, (_, index) => {
  const days = index + 1;
  total += rateForDay(days);
  return { days, price: total };
});
---

<section id="pricing" class="py-20 bg-gray-50 dark:bg-gray-800">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-gray-900 dark:text-white">
      Pricing
    </h2>
    <p class="-mt-8 mb-12 text-center text-gray-700 dark:text-gray-300">Total prices in Japanese yen for each booking length. Availability and final terms will be confirmed before payment.</p>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {plans.map((plan) => (
        <div class="rounded-lg border bg-white/90 p-4 shadow dark:bg-gray-900">
          <h3 class="mb-1 text-base font-semibold text-gray-700 dark:text-gray-300">
            {plan.days} {plan.days === 1 ? "day" : "days"}
          </h3>
          <p class="text-xl font-bold text-gray-900 dark:text-gray-100">¥{plan.price.toLocaleString("en-US")}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center text-gray-700 dark:text-gray-300">
      For bookings of 32 days or more, <a href="mailto:fritz@fritz.jp?subject=IS250C%20long-term%20booking%20inquiry" class="font-semibold underline">contact us for a quote</a>.
    </p>
  </div>
</section>
